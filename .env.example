# Copy this file to .env and fill in the values.
# Every variable except OPENAI_API_KEY has a default in src/config.js.

# Express
PORT=8000

# Redis (BullMQ backing store) - started by docker-compose
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Qdrant (vector DB) - started by docker-compose
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# OpenAI (required)
OPENAI_API_KEY=your-openai-api-key

# text-embedding-3-small -> 1536 dims, text-embedding-3-large -> 3072 dims
# If you change the embedding model or dimensions, use a new QDRANT_COLLECTION
# (or delete the old one), because existing vectors won't match.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# Chunking (in characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
# Candidates fetched from Qdrant per query
RETRIEVAL_TOP_K=4
# Reciprocal Rank Fusion constant
RRF_K=60
# Chunks kept after fusion and sent to the LLM
RETRIEVAL_FINAL_K=5
